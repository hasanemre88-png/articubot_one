<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- KODDA DEĞİŞTİ: RPLIDAR A2M12 yaklaşık gövde ölçüleri -->
    <xacro:property name="lidar_radius" value="0.038"/>
    <xacro:property name="lidar_height" value="0.041"/>
    <xacro:property name="lidar_mass" value="0.190"/>

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <!-- KODDA DEĞİŞTİ: Lidar kasanın tam ortasında, doğrudan üstünde; kablo arkaya baktığı için yaw 0 -->
        <origin xyz="${chassis_length / 2} 0 ${chassis_height + lidar_height / 2}" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/> <!-- KODDA DEĞİŞTİ -->
            </geometry>
            <material name="black"/>
        </visual>
        <!-- KODDA DEĞİŞTİ: Josh'un lidar taşıyıcı direği kaldırıldı; lidar doğrudan kasanın üstünde -->
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/> <!-- KODDA DEĞİŞTİ -->
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${lidar_mass}" length="${lidar_height}" radius="${lidar_radius}"> <!-- KODDA DEĞİŞTİ -->
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>

        <sensor name="laser" type="gpu_lidar">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.2</min> <!-- KODDA DEĞİŞTİ: A2M12 minimum menzil -->
                    <max>12.0</max> <!-- KODDA DEĞİŞTİ: A2M12 maksimum menzil -->
                </range>
            </lidar>
            <topic>scan</topic>
            <gz_frame_id>laser_frame</gz_frame_id>
        </sensor>
    </gazebo>

</robot>